# N60 Pro #56 hardware acceleration restoration
# Apply only after the #55 base config has been rebased/resolved.
# Keep the proven Golden 7.6.6.1 RF/EEPROM settings unchanged.

CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-warp=y

# Proprietary mt_wifi fast-NAT / WHNAT path.
CONFIG_MTK_FAST_NAT_SUPPORT=y
CONFIG_MTK_WHNAT_SUPPORT=m
CONFIG_MTK_WARP_V2=y

# MT7986 WARP settings from the pinned Linux 6.12 donor.
CONFIG_WARP_CHIPSET="mt7986"
CONFIG_WARP_VERSION=2
CONFIG_WED_HW_RRO_SUPPORT=y

# Keep debug-only WARP features off for the first real-device gate.
# CONFIG_WARP_DBG_SUPPORT is not set
# CONFIG_WARP_MEMORY_LEAK_DBG is not set
# CONFIG_WARP_WO_EMBEDDED_LOAD is not set
